# Optional: the provider-supported browser/project key. It is public in the bundle.
# Leave blank for the GraphQL workbench without AI chat. Never paste a server secret.
NEXT_PUBLIC_TAMBO_API_KEY=

# Optional AI provider URL; leave blank to use the default Tambo API.
NEXT_PUBLIC_TAMBO_URL=

# Optional exact endpoint allowlist for local use, comma-separated.
# Scheme, host, port, path, and query string must match; redirects stay disabled.
# Empty means arbitrary public HTTP(S) endpoints, still subject to IP/DNS validation.
GRAPHQL_ALLOWED_ENDPOINTS=
# GRAPHQL_ALLOWED_ENDPOINTS=https://countries.trevorblades.com/graphql
